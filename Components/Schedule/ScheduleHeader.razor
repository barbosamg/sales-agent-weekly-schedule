@namespace Cobalt.SalesAgentSchedule.Components.Schedule

<div class="schedule-row schedule-header-row">
    <div class="schedule-label-cell"></div>
    @foreach (var day in WeekDays)
    {
        <div class="schedule-day-header">
            <div class="schedule-day-title">@day.DayOfWeek <span class="schedule-day-date">@day.ToString("MM/dd")</span></div>
            <div class="schedule-hour-ticks">
                @for (var hour = ScheduleTimes.StartHour; hour < ScheduleTimes.EndHour; hour++)
                {
                    <span>@FormatHour(hour)</span>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DateOnly> WeekDays { get; set; } = Array.Empty<DateOnly>();

    // Bare hour numbers (no AM/PM suffix) - the 7 AM-7 PM window is already stated
    // in the page header, so repeating "a"/"p" on all twelve ticks was just noise.
    private static string FormatHour(int hour) => hour switch
    {
        12 => "12",
        > 12 => $"{hour - 12}",
        _ => $"{hour}",
    };
}
