@namespace Cobalt.SalesAgentSchedule.Components.Schedule

<div class="schedule-block @(Block.Entry.Kind == ShiftKind.Tentative ? "is-tentative" : "is-confirmed") @(Block.IsConflict ? "is-conflict" : "") @(IsNarrow ? "is-narrow" : "")"
     style="@Style"
     tabindex="0"
     role="button"
     title="@TooltipText"
     @onclick="HandleSelect"
     @onkeydown="HandleKeyDown">
    @if (Block.IsConflict)
    {
        <span class="conflict-icon" aria-hidden="true">⚠</span>
    }
    @if (IsNarrow)
    {
        <span class="block-time">@NarrowLabel</span>
    }
    else
    {
        <span class="block-time">@CompactTimeRange</span>
        <span class="block-title">@Block.Entry.Title</span>
    }
</div>

@code {
    private const double LaneHeightPx = 36;
    private const double LaneGapPx = 4;

    [Parameter, EditorRequired]
    public PositionedBlock Block { get; set; } = null!;

    [Parameter]
    public EventCallback<ScheduleEntry> OnSelected { get; set; }

    private string Style
    {
        get
        {
            var startHours = Block.Entry.Start.ToTimeSpan().TotalHours - ScheduleTimes.StartHour;
            var durationHours = (Block.Entry.End - Block.Entry.Start).TotalHours;
            var leftPercent = startHours / ScheduleTimes.TotalHours * 100;
            var widthPercent = durationHours / ScheduleTimes.TotalHours * 100;
            var top = Block.Lane * (LaneHeightPx + LaneGapPx);

            return $"left: calc({leftPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}% + 2px); " +
                   $"width: calc({widthPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}% - 4px); " +
                   $"top: {top.ToString(System.Globalization.CultureInfo.InvariantCulture)}px; " +
                   $"height: {LaneHeightPx.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";
        }
    }

    /// <summary>
    /// Short "7a–3p" style range. All mock entries fall on the hour, so minutes are
    /// always :00 and safe to drop — this keeps the time legible even in the
    /// narrowest (1-2 hour) blocks, where "7:00AM–9:00AM" would just get clipped.
    /// </summary>
    private string CompactTimeRange => $"{FormatHour(Block.Entry.Start)}–{FormatHour(Block.Entry.End)}";

    /// <summary>
    /// Blocks 2h or shorter don't have room for a time line *and* a legible title
    /// line — showing both just produces two truncated fragments (e.g. "2p.." /
    /// "Pr.."). Narrow blocks show only the start hour; full details stay one
    /// tap/hover away via the tooltip and dialog.
    /// </summary>
    private bool IsNarrow => (Block.Entry.End - Block.Entry.Start).TotalHours <= 2;

    /// <summary>
    /// Bare start hour ("8", "2") for narrow blocks — even the compact "8a–10a"
    /// range doesn't reliably fit a ~36px 2h block (worst case "10a–12p" needs ~43px
    /// of text in ~24px of available content width). Bare numbers also match the
    /// header's own hour-tick formatting, so the block visually lines up with its
    /// start tick instead of introducing a different notation.
    /// </summary>
    private string NarrowLabel => FormatBareHour(Block.Entry.Start.Hour);

    private static string FormatBareHour(int hour) => hour switch
    {
        12 => "12",
        > 12 => $"{hour - 12}",
        _ => $"{hour}",
    };

    private static string FormatHour(TimeOnly t)
    {
        var hour12 = t.Hour % 12 == 0 ? 12 : t.Hour % 12;
        var suffix = t.Hour < 12 ? "a" : "p";
        return $"{hour12}{suffix}";
    }

    private string TooltipText
    {
        get
        {
            var status = Block.IsConflict ? "Scheduling conflict" : Block.Entry.Kind == ShiftKind.Tentative ? "Tentative" : "Confirmed";
            var customer = string.IsNullOrWhiteSpace(Block.Entry.Customer) ? "" : $" • {Block.Entry.Customer}";
            return $"{Block.Entry.Title}{customer} — {Block.Entry.Start:h:mmtt}–{Block.Entry.End:h:mmtt} — {status}";
        }
    }

    private Task HandleSelect() => OnSelected.InvokeAsync(Block.Entry);

    private Task HandleKeyDown(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? OnSelected.InvokeAsync(Block.Entry) : Task.CompletedTask;
}
