@namespace Cobalt.SalesAgentSchedule.Components.Schedule

<div class="schedule-block @(Block.Entry.Kind == ShiftKind.Tentative ? "is-tentative" : "is-confirmed") @(Block.IsConflict ? "is-conflict" : "") @(IsNarrow ? "is-narrow" : "")"
     style="@Style"
     tabindex="0"
     role="button"
     title="@TooltipText"
     @onclick="HandleSelect"
     @onkeydown="HandleKeyDown">
    @if (IsNarrow)
    {
        <span class="block-time">@WarningPrefix@NarrowLabel</span>
    }
    else
    {
        <span class="block-time">@WarningPrefix@CompactTimeRange</span>
        <span class="block-title">@Block.Entry.Title</span>
    }
</div>

@code {
    private const double LaneHeightPx = 36;
    private const double LaneGapPx = 4;

    [Parameter, EditorRequired]
    public PositionedBlock Block { get; set; } = null!;

    [Parameter]
    public EventCallback<ScheduleEntry> OnSelected { get; set; }

    private string Style
    {
        get
        {
            var leftPercent = (VisibleStartHours - ScheduleTimes.StartHour) / ScheduleTimes.TotalHours * 100;
            var widthPercent = (VisibleEndHours - VisibleStartHours) / ScheduleTimes.TotalHours * 100;
            var top = Block.Lane * (LaneHeightPx + LaneGapPx);

            return $"left: calc({leftPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}% + 2px); " +
                   $"width: calc({widthPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)}% - 4px); " +
                   $"top: {top.ToString(System.Globalization.CultureInfo.InvariantCulture)}px; " +
                   $"height: {LaneHeightPx.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";
        }
    }

    // Clamped to the 7 AM-7 PM window: an entry that starts/ends outside it (data error,
    // or a future non-mock source) still renders fully inside the day cell instead of
    // overflowing into the next day's column - the tooltip/dialog still show the real time.
    private double VisibleStartHours => Math.Clamp(Block.Entry.Start.ToTimeSpan().TotalHours, ScheduleTimes.StartHour, ScheduleTimes.EndHour);

    private double VisibleEndHours => Math.Clamp(Block.Entry.End.ToTimeSpan().TotalHours, ScheduleTimes.StartHour, ScheduleTimes.EndHour);

    /// <summary>
    /// Warning glyph rendered inline, in normal text flow, right before the time -
    /// not absolutely positioned over the corner. An overlaid icon reserves no
    /// space of its own, so on narrower conflict blocks it either collided with
    /// the time text or (once a max-width was added to dodge it) ate most of the
    /// available width and left the time itself ellipsis-truncated to 2-3 chars.
    /// Inline, it just becomes part of the one string that gets measured and
    /// truncated as a whole - one predictable failure mode instead of two.
    /// </summary>
    // U+2002 (en space), not a plain space: a regular space here can visually
    // collapse tight against the bold glyph at this font size, and "nowrap"
    // doesn't stop consecutive plain spaces from collapsing anyway - a fixed-
    // width space character keeps the gap consistent instead.
    private string WarningPrefix => Block.IsConflict ? "⚠ " : "";

    /// <summary>
    /// Short "7–3" style range using bare hour numbers - no AM/PM suffix. Every
    /// mock entry sits inside the 7 AM-7 PM window, where the header itself
    /// already prints bare numbers (7, 8, ... 12, 1, ... 6, 7) and the second
    /// half is unambiguously PM, so a block's own bare "2" reads the same way.
    /// Dropping "a"/"p" buys back the width the warning icon now costs inline,
    /// and all mock entries fall on the hour so there are no minutes to lose.
    /// </summary>
    private string CompactTimeRange => $"{FormatBareTime(Block.Entry.Start)}–{FormatBareTime(Block.Entry.End)}";

    /// <summary>
    /// Blocks 2h or shorter don't have room for a time line *and* a legible title
    /// line — showing both just produces two truncated fragments. Narrow blocks
    /// show only the start hour; full details stay one tap/hover away via the
    /// tooltip and dialog.
    /// </summary>
    private bool IsNarrow => (VisibleEndHours - VisibleStartHours) <= 2;

    private string NarrowLabel => FormatBareTime(Block.Entry.Start);

    // Most mock entries fall on the hour, where minutes would just be visual noise
    // ("9:00" vs "9") - only append :mm when the entry actually needs that precision.
    private static string FormatBareTime(TimeOnly time)
    {
        var hour = FormatBareHour(time.Hour);
        return time.Minute == 0 ? hour : $"{hour}:{time.Minute:D2}";
    }

    private static string FormatBareHour(int hour) => hour switch
    {
        12 => "12",
        > 12 => $"{hour - 12}",
        _ => $"{hour}",
    };

    private string TooltipText
    {
        get
        {
            var status = Block.IsConflict ? "Scheduling conflict" : Block.Entry.Kind == ShiftKind.Tentative ? "Tentative" : "Confirmed";
            var customer = string.IsNullOrWhiteSpace(Block.Entry.Customer) ? "" : $" • {Block.Entry.Customer}";
            return $"{Block.Entry.Title}{customer} — {Block.Entry.Start:h:mmtt}–{Block.Entry.End:h:mmtt} — {status}";
        }
    }

    private Task HandleSelect() => OnSelected.InvokeAsync(Block.Entry);

    private Task HandleKeyDown(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? OnSelected.InvokeAsync(Block.Entry) : Task.CompletedTask;
}
